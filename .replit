modules = ["nodejs-20", "web", "postgresql-16", "python-base-3.13"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NODE_ENV = "production"
PORT = "5000"
ALIST_ADMIN_PASSWORD = "admin123"
ALIST_DATA_PATH = "/home/runner/workspace/data/alist"
ENABLE_ALIST = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export PATH=$PATH:/home/runner/.local/bin && cd backend && node server.js"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5244
externalPort = 3001
